# Порт сайта на сервере (80 для прямого входа по IP/домену)
APP_PORT=80

# PostgreSQL
POSTGRES_DB=okei_fest
POSTGRES_USER=okei
POSTGRES_PASSWORD=okei_super_secret_db_pass

# Безопасность API и админки (ОБЯЗАТЕЛЬНО поменяй на сервере!)
JWT_SECRET=okei-fest-2026-ultra-secret-jwt-key
ADMIN_PASSWORD=okei-admin-2026
ALLOWED_ORIGIN=*

